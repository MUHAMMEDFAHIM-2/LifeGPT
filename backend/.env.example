DATABASE_URL=sqlite:///./lifegpt.db

# LLM (Phase 7+)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-from-aistudio.google.com
GEMINI_MODEL=gemini-3.5-flash

# Push notifications (Phase 10) — generate your own with:
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys()"
# then set VAPID_PUBLIC_KEY from the printed application server key and
# save the private key PEM as the file VAPID_PRIVATE_KEY_FILE points to.
# In the cloud, set VAPID_PRIVATE_KEY (the raw base64url key) instead — it
# takes priority over the file, since hosts don't give you a persistent
# filesystem for secrets.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_FILE=vapid_private.pem
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=you@example.com
REMINDER_HOUR=21

# --- Cloud deployment only (leave blank for local/LAN dev) ---

# Locks the whole app behind a password. Blank = no login at all.
APP_PASSWORD=

# "internal" runs the per-minute reminder loop in-process (local dev).
# "external" disables it — GitHub Actions calls /api/push/send-reminder
# once a day instead, since a free-tier server sleeps between requests.
REMINDER_MODE=internal
# Shared secret the GitHub Actions workflow sends as X-Cron-Secret.
CRON_SECRET=

# Comma-separated extra origins for CORS, e.g. your Vercel URL.
EXTRA_CORS_ORIGINS=
